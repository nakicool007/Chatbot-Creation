# Required for app-level password protection unless auth is handled upstream.
# Prefer APP_PASSWORD_SHA256 in shared environments.
APP_PASSWORD=
APP_PASSWORD_SHA256=
AUTH_HANDLED_UPSTREAM=false

# Use a mounted folder or controlled document location in production.
PLAYBOOK_DOCS_DIR=docs

# Optional semicolon-separated PDF paths. Relative paths resolve from the repo root.
PLAYBOOK_PDF_PATHS=

# Remote Ollama endpoint for deployed environments.
# Example: http://ollama.internal:11434
OLLAMA_HOST=
OLLAMA_TIMEOUT_SECONDS=90

# Semicolon-separated allowlist, or "*" to expose every model returned by Ollama.
OLLAMA_MODELS=llama3.2;deepseek-r1:7b;qwen3:8b;gemma4

# Keep free-form model chat disabled by default for playbook-only answers.
ALLOW_FREE_CHAT=false

MAX_PROMPT_CHARS=4000
MAX_HISTORY_MESSAGES=10
MIN_RETRIEVAL_SCORE=0.03
LOG_LEVEL=INFO
